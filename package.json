{
  "name": "itemmanager-workspace",
  "version": "26.1.2",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --dir web dev",
    "build": "pnpm --dir web build",
    "test": "pnpm test:web && pnpm test:desktop && vitest run",
    "test:web": "pnpm --dir web test",
    "test:desktop": "pnpm --dir desktop test",
    "web:start": "pnpm --dir web start",
    "web:preview": "pnpm --dir web preview",
    "desktop:dev": "pnpm --dir desktop dev",
    "desktop:build": "pnpm --dir desktop build"
  },
  "devDependencies": {
    "vitest": "^4.1.0"
  }
}
