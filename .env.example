STORAGE_IMAGE=ghcr.io/cimorn/storage:latest
STORAGE_BIND_ADDRESS=127.0.0.1
STORAGE_BIND_PORT=8094
STORAGE_PUBLIC_ORIGIN=http://localhost:8094
STORAGE_ALLOW_HTTP=true

STORAGE_PASSWORD=replace_with_access_password_at_least_12_characters
STORAGE_PRIVACY_PASSWORD=replace_with_private_area_password
STORAGE_ALLOW_SHORT_PASSWORD=false
STORAGE_SESSION_SECRET=replace_with_generated_secret
STORAGE_ENCRYPTION_KEY=replace_with_generated_64_character_hex_key
STORAGE_PRIVACY_TAGS=

STORAGE_MONGO_ROOT_USERNAME=storage_root
STORAGE_MONGO_ROOT_PASSWORD=replace_with_generated_secret
STORAGE_MONGO_USERNAME=storage_app
STORAGE_MONGO_PASSWORD=replace_with_generated_secret

ALI_OSS_ACCESS_KEY_ID=replace_with_your_access_key_id
ALI_OSS_ACCESS_KEY_SECRET=replace_with_your_access_key_secret
ALI_OSS_BUCKET=replace-with-your-bucket
ALI_OSS_REGION=cn-hangzhou
ALI_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
